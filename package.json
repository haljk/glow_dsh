{
  "name": "@local/glow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Glow / 阁楼 — a personal image studio for DSH: text-to-image, preset-driven photo retouching, multi-reference composition, background job queueing and LLM-written prompts, all against local model services.",
  "repository": {
    "type": "git",
    "url": "https://github.com/haljk/glow_dsh.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
