    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="18"
                android:gradientRadius="96">
                <item
                    android:offset="0"
                    android:color="#FF7C61FF" />
                <item
