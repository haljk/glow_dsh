<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon: 24dp, single colour, filled silhouette only.
       The first version was drawn with strokes, which renders fine at panel size but
       left the status-bar slot empty: at 18dp those 2-unit strokes are about one
       pixel of antialiasing. Small icons are alpha masks, so the shape has to be
       solid; the window is punched out with evenOdd rather than drawn as a line. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,3.4 L21.6,12.1 L21.6,20.6 L2.4,20.6 L2.4,12.1 Z M12,9.1 L16.1,13.5 L7.9,13.5 Z" />
</vector>