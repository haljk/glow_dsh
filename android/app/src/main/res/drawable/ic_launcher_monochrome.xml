<!-- Themed-icon layer (Android 13+). The system replaces every colour with its own
     tint, so this layer can only be a silhouette: a gable with the lit window
     punched out by evenOdd. Anything relying on the amber glow or the texture would
     collapse to a dark blob here. Apex 54,20; eaves at y=54; wall down to y=90. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,20 L98,54 L98,90 L10,90 L10,54 Z M54,44 L74,66 L34,66 Z" />
</vector>