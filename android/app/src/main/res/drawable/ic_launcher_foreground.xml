<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground layer: the designed artwork, full bleed on the 108dp canvas.
     It is a bitmap because the design relies on texture and a soft light falloff
     that no reasonable vector would reproduce; the launcher mask crops only the
     navy corners. The same drawable doubles as the splash-screen icon, so a cold
     start shows the mark that is about to appear on the home screen. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_art"
    android:gravity="fill" />