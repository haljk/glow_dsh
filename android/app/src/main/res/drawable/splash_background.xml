<?xml version="1.0" encoding="utf-8"?>
<!-- Full-window launch surface: the same vertical ramp as the icon background, so
     the splash icon sits on it without a seam at top or bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF1E2A3A"
        android:endColor="#FF0C0F14" />
</shape>